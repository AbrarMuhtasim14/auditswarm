# AuditSwarm Environment Variables
# For dry-run/mock demo mode, no real keys or funds are required.

# LLM Provider Configuration (MUSE / OpenAI compatible)
MUSE_MODEL=muse-spark-1.3-contributor
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_API_KEY=your_muse_api_key_here

# NEAR Protocol Configuration
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_ROOT_ACCOUNT=auditswarm-9003.testnet
COORDINATOR_ACCOUNT=coordinator.auditswarm-9003.testnet
HUNTER_ACCOUNT=hunter.auditswarm-9003.testnet
CRITIC_ACCOUNT=critic.auditswarm-9003.testnet
ECONOMIC_ACCOUNT=economic.auditswarm-9003.testnet
